# Copia este archivo a .env y ajusta los valores para tu entorno.

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://barmultisede:barmultisede@localhost:5432/barmultisede

# Autenticación
# Genera uno propio en producción, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Reglas de seguridad (Propuesta Comercial, capítulo 17 / HU-003, HU-006)
LOGIN_MAX_INTENTOS_FALLIDOS=3
SESION_INACTIVIDAD_MINUTOS=3

# CORS: origen permitido del frontend
CORS_ORIGIN=http://localhost:5173
